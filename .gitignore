.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.env
navigator.db
archives/
voices/
chroma/
registry.db
data/credentials.db
data/explore_episodes/
# SQLite WAL mode leaves these beside every .db; they are runtime state.
*.db-wal
*.db-shm
.navigator_client_key
.navigator_google_sa.json

# Accidental setuptools `python setup.py build` / editable leftovers
build/

# SDK build output. sdk/src/generated/ is Fern's output -- regenerate it with
# `npx fern-api generate`, never commit it.
sdk/node_modules/
sdk/dist/
sdk/src/generated/

# Client console is a Vite app. dist/ is served by FastAPI but rebuilt from
# source with `npm run build` -- committing it would rot against src/.
navigator/client/web/node_modules/
navigator/client/web/dist/
navigator/client/web/*.tsbuildinfo

# Written by `fern generate`, not by navigator.docs -- so `docs check` cannot
# keep it current and committing it would just rot.
fern/openapi/ai_examples_override.yml
.tools/



# graphify local knowledge graph (never commit)
graphify-out/
graphify/

# Architecture / handoff / plans — local only. Do not publish to GitHub.
*.md
docs/**/*.html

# Fern BuildWithFern public docs (generated + committed)
!fern/**/*.md
!fern/**/*.mdx

# Standing rules every contributor and coding agent must read
!README.md
!CLAUDE.md
!AGENTS.md
!docs/PRODUCT_MODEL.md
!docs/ONBOARDING.md
!docs/DEVELOPER_ONBOARDING.md
!navigator/client/embed/README.md

# Test fixtures may use HTML/MD
!tests/**/*.html
!tests/**/*.md
