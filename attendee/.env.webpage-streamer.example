# Webpage streamer resolution and frame rate.
#
# Precedence: CLI flags, then these env vars, then the per-platform default.
#
# Platform defaults (when the vars below are unset):
#   Google Meet          1920x1080 @ 30fps   (Meet's screen-share ceiling)
#   Zoom                 1920x1080 @ 60fps
#   Microsoft Teams      1920x1080 @ 60fps
#   local / test         1920x1080 @ 60fps
#
# Google Meet still limits screen share to about 30 fps for viewers, even if the
# streamer captures faster.
#
# WEBPAGE_STREAMER_VIDEO_FRAME_SIZE pins the capture size. Leave
# WEBPAGE_STREAMER_VIDEO_FPS unset so Google Meet stays at 30fps and Zoom,
# Teams, and local/test stay at 60fps. Set WEBPAGE_STREAMER_VIDEO_FPS only
# when you want one rate for every platform.
#
# dev.docker-compose.1080p.yaml pins 1920x1080 and gives the streamer 4 CPUs
# and 8g of memory. It does not set WEBPAGE_STREAMER_VIDEO_FPS.
#   docker compose -f dev.docker-compose.yaml -f dev.docker-compose.1080p.yaml --profile webpage-streamer up

WEBPAGE_STREAMER_VIDEO_FRAME_SIZE=1920x1080
# WEBPAGE_STREAMER_VIDEO_FPS=60

# Kubernetes webpage-streamer pod. Defaults are 4 CPU and 8Gi, matching
# dev.docker-compose.1080p.yaml. There is no CPU limit unless
# WEBPAGE_STREAMING_CPU_LIMIT is set.
WEBPAGE_STREAMING_CPU_REQUEST=4
WEBPAGE_STREAMING_CPU_LIMIT=4
WEBPAGE_STREAMING_MEMORY_REQUEST=8Gi
WEBPAGE_STREAMING_MEMORY_LIMIT=8Gi

# VP8 bitrate in kbps. Unset scales with resolution and fps
# (1080p30 -> 3000, 1080p60 -> 6000). Keyframes are about every 2 seconds.
# WEBPAGE_STREAMER_VIDEO_BITRATE_KBPS=6000
