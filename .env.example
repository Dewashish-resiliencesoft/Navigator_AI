# --- Phase 1: everything below this line has a working default ---------------

# Show the browser window. 0 = headless (tests always force headless).
NAVIGATOR_HEADFUL=1

# Site graph to load.
NAVIGATOR_SITE_GRAPH=navigator/config/sites/whatsapp_crm.yaml

# ActionLog storage. SQLite for now; swaps to Postgres in a later phase.
NAVIGATOR_DB_PATH=navigator.db

# Product registry (wrapper API): who we demo for, and their site graphs.
NAVIGATOR_REGISTRY_DB=registry.db

# Piper voice model (fallback when Fish key unset). Download with:
#   python -m piper.download_voices en_US-lessac-medium
NAVIGATOR_PIPER_VOICE=en_US-lessac-medium
NAVIGATOR_PIPER_DATA_DIR=voices

# Fish Audio — main Meet TTS (free S2.1 Pro + Sarah). https://fish.audio/app/
# auto = Fish when key set, else Piper. Set fish to force Fish.
NAVIGATOR_TTS_PROVIDER=auto
NAVIGATOR_FISH_API_KEY=
NAVIGATOR_FISH_MODEL=s2.1-pro-free
# Default Sarah (warm young conversational): fish.audio/m/3a7a3d3df82948c6bd756761d6b139b5
NAVIGATOR_FISH_REFERENCE_ID=3a7a3d3df82948c6bd756761d6b139b5

# --- Phase 2+: unused until the corresponding stub is filled in --------------

# Live conversation (Groq, free tier): llama-3.3-70b-versatile + whisper-large-v3-turbo
NAVIGATOR_GROQ_API_KEY=

# Offline reflection + vision verify. "gemini" is free tier; "openai" needs a paid key.
NAVIGATOR_REFLECT_PROVIDER=gemini
NAVIGATOR_GEMINI_API_KEY=
NAVIGATOR_OPENAI_API_KEY=

# Chroma persistence (product knowledge + corrections collections)
NAVIGATOR_CHROMA_PATH=chroma

# Attendee meeting bot API (self-hosted or app.attendee.dev)
# Localhost only works if you run Attendee yourself; cloud default:
NAVIGATOR_ATTENDEE_BASE_URL=https://app.attendee.dev/api/v1
NAVIGATOR_ATTENDEE_API_KEY=

# Phase 3: live Meet demo (never commit real secrets)
NAVIGATOR_MEETING_URL=
# Bot joins THIS Meet first, then prints the link. Needs Meet Quick access ON
# (Host controls → Meeting access → people can join without knocking).
# Attendee cannot create a new Meet URL; use a reusable instant/calendar link.
NAVIGATOR_LIVE_BOT_FIRST=1
# Optional: Attendee signed-in Google bot (Bot Logins in Attendee dashboard)
NAVIGATOR_GOOGLE_MEET_USE_LOGIN=0
NAVIGATOR_PRODUCT_URL=
NAVIGATOR_PRODUCT_LOGIN_EMAIL=
NAVIGATOR_PRODUCT_LOGIN_PASSWORD=
NAVIGATOR_TEAMS_WEBHOOK_URL=
# Auto-email Meet link via Resend (free): https://resend.com → API Keys
NAVIGATOR_RESEND_API_KEY=
NAVIGATOR_NOTIFY_EMAIL=
# Free-tier from-address (no domain verify needed)
NAVIGATOR_EMAIL_FROM=Navigator AI <onboarding@resend.dev>
# Open Meet on this machine (default 0)
NAVIGATOR_OPEN_MEET_IN_BROWSER=0
NAVIGATOR_TUNNEL_BIN=cloudflared
NAVIGATOR_MEET_LIVE=0
